# Production Environment Configuration
# These values should be set in Amplify's Environment Variables for the PRODUCTION app

# =============================================================================
# DATABASE CONFIGURATION (Production)
# =============================================================================
DATABASE_HOST=af-database.AHALKSDHLA.ap-south-1.rds.amazonaws.com
DATABASE_PORT=1357
DATABASE_USER=postgres
DATABASE_PASSWORD=<production-password>
DATABASE_NAME=prod_af_db

# =============================================================================
# DB SERVICE (Production)
# =============================================================================
DB_SERVICE_URL=https://db.avantifellows.org/api
DB_SERVICE_TOKEN=<production-token>

# =============================================================================
# AWS SNS (Session Creator)
# =============================================================================
AF_ACCESS_KEY_ID=
AF_SECRET_ACCESS_KEY=
AF_TOPIC_ARN=
APP_ENV=production

# =============================================================================
# NEXTAUTH CONFIGURATION
# =============================================================================
NEXTAUTH_URL=https://lms.avantifellows.org
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>

# =============================================================================
# GOOGLE OAUTH
# =============================================================================
# Same OAuth app can be used for both staging and production
# Just add both domains to authorized redirect URIs in Google Cloud Console
GOOGLE_CLIENT_ID=979652970101-ALSKHOPQWHDLASKDHASL.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google-secret>
# etl-next URL ending in /api/internal/holistic-profiles/regeneration-requests
HOLISTIC_PROFILE_ETL_URL=
HOLISTIC_PROFILE_ETL_TOKEN=

# Blended Learning (see .env.example for what each does; blank skips the step)
BLENDED_LEARNING_ETL_URL=
BLENDED_LEARNING_ETL_TOKEN=
BLENDED_LEARNING_SES_ACCESS_KEY_ID=
BLENDED_LEARNING_SES_SECRET_ACCESS_KEY=
BLENDED_LEARNING_SES_REGION=
BLENDED_LEARNING_WELLBEING_EMAILS=
