# Production Environment Configuration
# These values should be set in Amplify's Environment Variables for the PRODUCTION app

# =============================================================================
# DATABASE CONFIGURATION (Production)
# =============================================================================
DATABASE_HOST=af-database.AHALKSDHLA.ap-south-1.rds.amazonaws.com
DATABASE_PORT=1357
DATABASE_USER=postgres
DATABASE_PASSWORD=<production-password>
DATABASE_NAME=prod_af_db

# =============================================================================
# DB SERVICE (Production)
# =============================================================================
DB_SERVICE_URL=https://db.avantifellows.org/api
DB_SERVICE_TOKEN=<production-token>

# =============================================================================
# AWS SNS (Session Creator)
# =============================================================================
AF_ACCESS_KEY_ID=
AF_SECRET_ACCESS_KEY=
AF_TOPIC_ARN=
APP_ENV=production

# =============================================================================
# NEXTAUTH CONFIGURATION
# =============================================================================
NEXTAUTH_URL=https://lms.avantifellows.org
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>

# =============================================================================
# GOOGLE OAUTH
# =============================================================================
# Same OAuth app can be used for both staging and production
# Just add both domains to authorized redirect URIs in Google Cloud Console
GOOGLE_CLIENT_ID=979652970101-ALSKHOPQWHDLASKDHASL.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google-secret>
# etl-next URL ending in /api/internal/holistic-profiles/regeneration-requests
HOLISTIC_PROFILE_ETL_URL=
HOLISTIC_PROFILE_ETL_TOKEN=

# AI Test Insights delivery to AI Mentorship Guide. ENQUEUE_URL is the
# collection endpoint ending in /api/internal/insight-requests; the LMS posts
# {URL}/{request_key}/enqueue with the bearer ENQUEUE_SECRET. WAKE_URL is the
# base URL; the LMS posts {WAKE_URL}/start, and a blank one only skips the
# wake. Generate is off (503, nothing written) unless ENQUEUE_URL and
# ENQUEUE_SECRET are set and APP_ENV is staging or production.
AI_TEST_INSIGHTS_ENQUEUE_URL=
AI_TEST_INSIGHTS_ENQUEUE_SECRET=
AI_TEST_INSIGHTS_WAKE_URL=

# AI Test Insights artifact reader: reads a finished AI Summary (Test Insight)
# from the AI Mentorship Guide bucket with its own read-only key, separate
# from the S3_DOCS_* documents client. Reading is off (the summary route
# answers 503) unless BUCKET, ACCESS_KEY_ID and SECRET_ACCESS_KEY are set and
# APP_ENV is staging or production. REGION defaults to ap-south-1 and PREFIX
# to acad-mentorship when blank. The LMS only reads keys under
# {PREFIX}/{APP_ENV}/items/{item id}/.
AI_TEST_INSIGHTS_S3_BUCKET=
AI_TEST_INSIGHTS_S3_REGION=ap-south-1
AI_TEST_INSIGHTS_S3_PREFIX=acad-mentorship
AI_TEST_INSIGHTS_S3_ACCESS_KEY_ID=
AI_TEST_INSIGHTS_S3_SECRET_ACCESS_KEY=
# (AI_TEST_INSIGHTS_S3_ENDPOINT is local only; deployed apps never set it.)

# Blended Learning (see .env.example for what each does; blank skips the step)
BLENDED_LEARNING_ETL_URL=
BLENDED_LEARNING_ETL_TOKEN=
BLENDED_LEARNING_SES_ACCESS_KEY_ID=
BLENDED_LEARNING_SES_SECRET_ACCESS_KEY=
BLENDED_LEARNING_SES_REGION=
BLENDED_LEARNING_WELLBEING_EMAILS=

# Holistic Mentorship Dictation (see .env.example; on only when the flag is "true" and both keys are set;
# leave the translation model blank for the default)
HOLISTIC_DICTATION_ENABLED=false
HOLISTIC_DICTATION_ELEVENLABS_API_KEY=
HOLISTIC_DICTATION_ELEVENLABS_ZERO_RETENTION=false
HOLISTIC_DICTATION_OPENROUTER_API_KEY=
HOLISTIC_DICTATION_TRANSLATION_MODEL=
